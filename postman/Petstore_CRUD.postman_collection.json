{
  "info": {
    "name": "Petstore CRUD Regression",
    "description": "Run the six requests in order. The suite creates, updates and deletes one synthetic pet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CREATE",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"petId\", \"\");",
              "const guid = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\");",
              "const petId = parseInt(guid.slice(0, 13), 16) || 1;",
              "pm.variables.set(\"requestedPetId\", String(petId));",
              "pm.collectionVariables.set(\"petName\", \"qa-pet-\" + guid);",
              "pm.collectionVariables.set(\"petStatus\", \"available\");",
              "pm.collectionVariables.set(\"updatedPetName\", \"qa-updated-pet-\" + guid);",
              "pm.collectionVariables.set(\"updatedPetStatus\", \"pending\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "let pet;",
              "pm.test(\"Response is valid JSON\", function () {",
              "  pet = pm.response.json();",
              "});",
              "",
              "pm.test(\"Response contains the required Pet fields and types\", function () {",
              "  pm.expect(pet).to.be.an(\"object\");",
              "  pm.expect(pet.id).to.be.a(\"number\");",
              "  pm.expect(Number.isSafeInteger(pet.id)).to.equal(true);",
              "  pm.expect(pet.name).to.be.a(\"string\");",
              "  pm.expect(pet.photoUrls).to.be.an(\"array\");",
              "  pet.photoUrls.forEach(function (url) {",
              "    pm.expect(url).to.be.a(\"string\");",
              "  });",
              "  pm.expect(pet.status).to.be.oneOf([\"available\", \"pending\", \"sold\"]);",
              "});",
              "",
              "pm.test(\"Pet id, name and status match the request data\", function () {",
              "  pm.expect(pet).to.be.an(\"object\");",
              "  pm.expect(pet.id).to.equal(Number(pm.variables.get(\"requestedPetId\")));",
              "  pm.expect(pet.name).to.equal(pm.collectionVariables.get(\"petName\"));",
              "  pm.expect(pet.status).to.equal(pm.collectionVariables.get(\"petStatus\"));",
              "});",
              "",
              "if (pm.response.code === 200 && pet && pet.id === Number(pm.variables.get(\"requestedPetId\"))",
              "    && pet.name === pm.collectionVariables.get(\"petName\")",
              "    && pet.status === pm.collectionVariables.get(\"petStatus\")) {",
              "  pm.collectionVariables.set(\"petId\", String(pet.id));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v3/pet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v3",
            "pet"
          ]
        },
        "description": "OpenAPI operation: [addPet](https://petstore3.swagger.io/#/pet/addPet). [OpenAPI JSON](https://petstore3.swagger.io/api/v3/openapi.json).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{requestedPetId}},\n  \"name\": \"{{petName}}\",\n  \"photoUrls\": [],\n  \"status\": \"{{petStatus}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
